<Page
    x:Class="Xcord.Widget.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Xcord.Widget"
    Background="{StaticResource XcBackground}"
    Foreground="{StaticResource XcText}"
    XYFocusKeyboardNavigation="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: account + connection status -->
        <Grid Background="{StaticResource XcSurfaceDark}" Padding="12,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="32" Height="32">
                <Ellipse Fill="{StaticResource XcAccent}" />
                <TextBlock Text="X" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse>
                    <Ellipse.Fill>
                        <ImageBrush x:Name="UserAvatarBrush" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="UserNameText" Text="Xcord" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource XcMuted}" />
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource XcMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8">
                <FontIcon FontFamily="{StaticResource XcIcons}" Glyph="&#xE712;" FontSize="16" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Uid="MenuOpenDiscord" Text="Open Discord" Click="OpenDiscord_Click" />
                        <MenuFlyoutItem x:Name="DiscordAppItem" x:Uid="MenuDiscordApp" Text="Discord app…" Click="DiscordApp_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="LogoutItem" x:Uid="MenuLogout" Text="Sign out" Click="Logout_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Everything that isn't "ready": starting, Discord closed, needs authorization... -->
        <StackPanel x:Name="StatusPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="24" Spacing="12" MaxWidth="300">
            <FontIcon x:Name="StatusIcon" FontFamily="{StaticResource XcIcons}" FontSize="40" Glyph="&#xE895;" Foreground="{StaticResource XcAccent}" />
            <ProgressRing x:Name="StatusProgress" Width="36" Height="36" IsActive="True" />
            <TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusDetail" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource XcMuted}" />
            <Button x:Name="StatusAction" HorizontalAlignment="Center" Padding="24,8" CornerRadius="4"
                    Background="{StaticResource XcAccent}" Foreground="White" Click="StatusAction_Click" />
        </StackPanel>

        <!-- First run (or menu → Discord app): each user brings their own Discord application. -->
        <ScrollViewer x:Name="SetupPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16" Spacing="14" MaxWidth="440">
                <TextBlock x:Uid="SetupTitle" Text="Set up your Discord app" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Uid="SetupIntro" TextWrapping="Wrap" Foreground="{StaticResource XcMuted}"
                           Text="Discord only lets apps you own control voice. It takes 2 minutes, once." />

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" VerticalAlignment="Top">
                        <Ellipse Fill="{StaticResource XcAccent}" />
                        <TextBlock Text="1" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Column="1" x:Uid="SetupStep1" TextWrapping="Wrap"
                               Text="Open the Discord Developer Portal and click New Application (any name, e.g. Xcord)." />
                </Grid>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" VerticalAlignment="Top">
                        <Ellipse Fill="{StaticResource XcAccent}" />
                        <TextBlock Text="2" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Uid="SetupStep2" TextWrapping="Wrap"
                                   Text="In OAuth2: turn on Public Client and add this redirect, then Save Changes:" />
                        <Border Background="{StaticResource XcSurfaceDark}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="http://127.0.0.1" FontFamily="Consolas" IsTextSelectionEnabled="True" />
                        </Border>
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" VerticalAlignment="Top">
                        <Ellipse Fill="{StaticResource XcAccent}" />
                        <TextBlock Text="3" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Column="1" x:Uid="SetupStep3" TextWrapping="Wrap"
                               Text="Copy the Client ID (also on that page) and paste it below." />
                </Grid>

                <Button x:Uid="SetupOpenPortal" Content="Open Developer Portal" Click="OpenPortal_Click" />

                <StackPanel Spacing="6">
                    <TextBlock x:Uid="SetupClientIdLabel" Text="CLIENT ID" Style="{StaticResource XcCaption}" />
                    <TextBox x:Name="ClientIdBox" InputScope="Number" PlaceholderText="1234567890123456789" />
                    <TextBlock x:Name="SetupError" Foreground="{StaticResource XcRed}" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="SetupSave" Content="Save" Padding="24,8" CornerRadius="4"
                            Background="{StaticResource XcAccent}" Foreground="White" Click="SetupSave_Click" />
                    <Button x:Name="SetupCancel" x:Uid="SetupCancel" Content="Cancel" Padding="16,8" Click="SetupCancel_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Pivot x:Name="MainPivot" Grid.Row="1" Visibility="Collapsed">

            <PivotItem x:Uid="VoiceTab" Header="Voice" Margin="12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="0,8,0,16">

                        <Border x:Name="ChannelCard" CornerRadius="8" Background="{StaticResource XcSurface}" Padding="12">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource XcIcons}" Glyph="&#xE767;" FontSize="14" Foreground="{StaticResource XcGreen}" />
                                        <TextBlock x:Name="ChannelNameText" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock x:Name="GuildNameText" FontSize="12" Foreground="{StaticResource XcMuted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="CallTimerText" Grid.Column="1" VerticalAlignment="Center"
                                           FontFamily="Consolas" Foreground="{StaticResource XcGreen}" />
                            </Grid>
                        </Border>

                        <Border x:Name="NoChannelCard" CornerRadius="8" Background="{StaticResource XcSurface}" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="NotInVoice" Text="You're not in a voice channel" Foreground="{StaticResource XcMuted}" TextWrapping="Wrap" />
                                <Button x:Uid="PickChannel" Content="Choose a channel" Click="PickChannel_Click" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MuteButton" Style="{StaticResource XcControlButton}" Click="Mute_Click">
                                <StackPanel Spacing="2">
                                    <FontIcon FontFamily="{StaticResource XcIcons}" Glyph="&#xE720;" FontSize="18" />
                                    <TextBlock x:Name="MuteLabel" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeafButton" Grid.Column="1" Style="{StaticResource XcControlButton}" Click="Deaf_Click">
                                <StackPanel Spacing="2">
                                    <FontIcon FontFamily="{StaticResource XcIcons}" Glyph="&#xE7F6;" FontSize="18" />
                                    <TextBlock x:Name="DeafLabel" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LeaveButton" Grid.Column="2" Style="{StaticResource XcControlButton}"
                                    Background="{StaticResource XcRed}" Click="Leave_Click">
                                <StackPanel Spacing="2">
                                    <FontIcon FontFamily="{StaticResource XcIcons}" Glyph="&#xE778;" FontSize="18" />
                                    <TextBlock x:Uid="LeaveLabel" Text="Leave" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel>
                            <Grid>
                                <TextBlock x:Uid="InputVolume" Text="Microphone" Style="{StaticResource XcCaption}" />
                                <TextBlock x:Name="InputVolumeText" HorizontalAlignment="Right" Style="{StaticResource XcCaption}" />
                            </Grid>
                            <Slider x:Name="InputSlider" Minimum="0" Maximum="100" StepFrequency="1" SmallChange="5" LargeChange="10"
                                    ValueChanged="InputSlider_ValueChanged" />
                        </StackPanel>

                        <StackPanel>
                            <Grid>
                                <TextBlock x:Uid="OutputVolume" Text="Sound" Style="{StaticResource XcCaption}" />
                                <TextBlock x:Name="OutputVolumeText" HorizontalAlignment="Right" Style="{StaticResource XcCaption}" />
                            </Grid>
                            <Slider x:Name="OutputSlider" Minimum="0" Maximum="200" StepFrequency="1" SmallChange="5" LargeChange="10"
                                    ValueChanged="OutputSlider_ValueChanged" />
                        </StackPanel>

                        <TextBlock x:Name="MembersHeader" Style="{StaticResource XcCaption}" />
                        <ListView x:Name="MembersList" ItemsSource="{x:Bind Members}" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="Member_ItemClick" ScrollViewer.VerticalScrollMode="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="4,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:MemberVm">
                                    <Grid Padding="0,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="38" Height="38">
                                            <Ellipse Stroke="{StaticResource XcGreen}" StrokeThickness="2.5" Opacity="{x:Bind SpeakingOpacity, Mode=OneWay}" />
                                            <Ellipse Margin="4">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{x:Bind Avatar, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind VolumeText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource XcMuted}"
                                                       Visibility="{x:Bind HasCustomVolume, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource XcIcons}" Glyph="&#xE74F;" FontSize="14"
                                                      Foreground="{StaticResource XcMuted}" Visibility="{x:Bind LocalMute, Mode=OneWay}" />
                                            <FontIcon FontFamily="{StaticResource XcIcons}" Glyph="&#xE720;" FontSize="14"
                                                      Foreground="{StaticResource XcRed}" Visibility="{x:Bind SelfMute, Mode=OneWay}" />
                                            <FontIcon FontFamily="{StaticResource XcIcons}" Glyph="&#xE7F6;" FontSize="14"
                                                      Foreground="{StaticResource XcRed}" Visibility="{x:Bind SelfDeaf, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem x:Uid="ServersTab" Header="Servers" Margin="12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="ChannelsHeader" Visibility="Collapsed" ColumnSpacing="8" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Click="BackToGuilds_Click" Padding="8">
                            <FontIcon FontFamily="{StaticResource XcIcons}" Glyph="&#xE72B;" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="SelectedGuildText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <ProgressRing x:Name="BrowseProgress" Grid.Row="1" Width="32" Height="32" VerticalAlignment="Top" Margin="0,24" />
                    <TextBlock x:Name="BrowseError" Grid.Row="1" Margin="0,24" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource XcMuted}" Visibility="Collapsed" />

                    <ListView x:Name="GuildList" Grid.Row="1" ItemsSource="{x:Bind Guilds}" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="Guild_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:GuildVm">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="36" Height="36">
                                        <Ellipse Fill="{StaticResource XcSurface}" />
                                        <TextBlock Text="{x:Bind Initials}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{x:Bind Icon}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ListView x:Name="ChannelList" Grid.Row="1" ItemsSource="{x:Bind Channels}" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="Channel_ItemClick" Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ChannelVm">
                                <Grid Padding="0,10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontFamily="{StaticResource XcIcons}" Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{StaticResource XcMuted}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{StaticResource XcGreen}"
                                             Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
