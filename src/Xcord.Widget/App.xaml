<Application
    x:Class="Xcord.Widget.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="XcAccentColor">#5865F2</Color>
            <SolidColorBrush x:Key="XcBackground" Color="#F2313338" />
            <SolidColorBrush x:Key="XcSurface" Color="#2B2D31" />
            <SolidColorBrush x:Key="XcSurfaceDark" Color="#1E1F22" />
            <SolidColorBrush x:Key="XcAccent" Color="{StaticResource XcAccentColor}" />
            <SolidColorBrush x:Key="XcGreen" Color="#23A55A" />
            <SolidColorBrush x:Key="XcRed" Color="#F23F43" />
            <SolidColorBrush x:Key="XcText" Color="#F2F3F5" />
            <SolidColorBrush x:Key="XcMuted" Color="#B5BAC1" />
            <FontFamily x:Key="XcIcons">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>

            <Style x:Key="XcControlButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="56" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{StaticResource XcSurface}" />
                <Setter Property="Foreground" Value="{StaticResource XcText}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="XcCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource XcMuted}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
